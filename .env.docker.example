# Workbench Docker environment template
#
# Copy this file to .env.docker and keep that file outside Git. Never commit
# real credentials. Browser-facing URLs must be reachable from user devices.

APP_DATA_DIR=/opt/workbench/data
VIEWER_PUBLISHED_DIR=/opt/workbench/data/published
SERVER_IP=127.0.0.1

NEXT_PUBLIC_SCREENSHOT_SERVICE_URL=http://127.0.0.1:3202
NEXT_PUBLIC_WEB_URL=http://127.0.0.1:3200
NEXT_PUBLIC_VIEWER_URL=http://127.0.0.1:3300
DOCKER_CORS_ORIGINS=http://127.0.0.1:3200,http://127.0.0.1:3300,http://localhost:3200,http://localhost:3300

JWT_SECRET=
MODEL_CONFIG_ENCRYPTION_KEY=
EXTERNAL_AUTH_ENCRYPTION_KEY=
AUTH_COOKIE_NAME=auth_token_docker
USE_SECURE_COOKIE=false
ADMIN_SECRET=
INTERNAL_API_TOKEN=

PI_AGENT_API_KEY=
PI_AGENT_PROVIDER=anthropic
PI_AGENT_MODEL=
PI_AGENT_BASE_URL=
PI_AGENT_TIMEOUT=120000
PI_AGENT_PROVIDERS=

FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=http://127.0.0.1:3200/api/user/external-auth/figma/callback
FIGMA_OAUTH_POST_AUTH_ORIGIN=
FIGMA_OAUTH_TARGET_ID=dev
FIGMA_OAUTH_HANDOFF_SECRET=
FIGMA_OAUTH_TARGETS_JSON={"dev":"http://127.0.0.1:3200"}

DINGTALK_LOGIN_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_HOME_URL=http://127.0.0.1:3200
DINGTALK_LOGIN_REDIRECT_URI=http://127.0.0.1:3200/api/auth/dingtalk/callback
DINGTALK_LOGIN_SCOPE=openid
DINGTALK_LOGIN_PROMPT=consent
DINGTALK_LOGIN_TARGET_ID=dev
DINGTALK_LOGIN_HANDOFF_SECRET=
DINGTALK_LOGIN_TARGETS_JSON={"dev":"http://127.0.0.1:3200"}
