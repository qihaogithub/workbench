{
  "extends": "../../tsconfig.next.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@workbench/sketch-core": [
        "../sketch-core/src"
      ],
      "@workbench/sketch-react": [
        "../sketch-react/src/index.tsx"
      ],
      "@workbench/sketch-react/*": [
        "../sketch-react/src/*"
      ],
      "@workbench/shared": [
        "../shared/src"
      ],
      "@workbench/demo-ui": [
        "../demo-ui/src/index.ts"
      ],
      "@workbench/demo-ui/*": [
        "../demo-ui/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
