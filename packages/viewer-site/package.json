    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rjsf/utils": "^6.4.2",
    "@workbench/agent-client": "workspace:*",
    "@workbench/ai-chat-shared": "workspace:*",
    "@workbench/demo-ui": "workspace:*",
    "@workbench/runtime-config": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@workbench/sketch-core": "workspace:*",
    "@workbench/sketch-react": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.2",
    "lucide-react": "0.575.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.11.16",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
