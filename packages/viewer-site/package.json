{
  "name": "@workbench/viewer-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 4300 -H 0.0.0.0",
    "dev:webpack": "next dev --webpack -p 4300 -H 0.0.0.0",
    "dev:turbo": "next dev --turbopack -p 4300 -H 0.0.0.0",
    "build": "corepack pnpm --workspace-root build:preview-runtime && next build --webpack",
    "build:webpack": "corepack pnpm --workspace-root build:preview-runtime && next build --webpack",
    "build:turbo": "corepack pnpm --workspace-root build:preview-runtime && next build --turbopack",
    "preview-runtime:build": "corepack pnpm --workspace-root build:preview-runtime",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
