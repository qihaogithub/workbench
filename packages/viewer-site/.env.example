PORT=4300

# 数据基础路径
# 本地开发：http://localhost:4200（从 author-site 获取发布数据）
# Docker/Cloudflare 部署：留空（数据与 viewer-site 同源，由 nginx 或 CDN 提供）
NEXT_PUBLIC_DATA_BASE=http://localhost:4200

# Agent 服务地址，用于使用端只读 AI 问答
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:4201

# OneFlow 官网/创作端地址，用于品牌链接
# NEXT_PUBLIC_AUTHOR_SITE_URL=http://localhost:4200

# 通过局域网 IP 访问 Next.js 开发服务时，填浏览器使用的 hostname
# NEXT_ALLOWED_DEV_ORIGINS=172.19.64.157
