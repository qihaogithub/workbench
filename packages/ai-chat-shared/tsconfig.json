{
  "extends": "../../tsconfig.browser.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["./src/*"],
      "@/components/ui/*": ["./src/ui/*"],
      "@/lib/utils": ["./src/lib/utils"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
