# Opencode Workbench local development environment
#
# Copy values into .env when needed. Keep .env private.

# ============================================
# author-site
# ============================================

# Required for login/session cookies in author-site.
JWT_SECRET=change-this-local-jwt-secret
# Dedicated at-rest encryption keys. Use independent random values.
MODEL_CONFIG_ENCRYPTION_KEY=
EXTERNAL_AUTH_ENCRYPTION_KEY=

# Local agent service URL used by author-site server-side API calls.
AGENT_SERVICE_URL=http://localhost:4201
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:4201

# Optional screenshot service URL. Required only for screenshot workflows.
SCREENSHOT_SERVICE_URL=http://localhost:4202
NEXT_PUBLIC_SCREENSHOT_SERVICE_URL=http://localhost:4202

# Shared internal token for author-site -> agent-service calls.
# Keep the same value in all services when enabled.
INTERNAL_API_TOKEN=local-internal-token

# Admin panel secret. Required only for admin routes.
ADMIN_SECRET=local-admin-secret

# Optional DingTalk enterprise login. The AppKey/AppSecret are the values
# shown as Client ID/Client Secret in the DingTalk developer console.
DINGTALK_LOGIN_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_LOGIN_REDIRECT_URI=http://localhost:4200/api/auth/dingtalk/callback
DINGTALK_LOGIN_SCOPE=openid
DINGTALK_LOGIN_PROMPT=consent
# Multi-environment browser login: every environment uses the same callback
# above, a unique target ID, and the same random secret (at least 32 bytes).
DINGTALK_LOGIN_TARGET_ID=dev
DINGTALK_LOGIN_HANDOFF_SECRET=
# Only the fixed callback environment needs this allowlist. Values must be origins.
DINGTALK_LOGIN_TARGETS_JSON={"dev":"http://10.0.0.11:4200","test":"http://10.0.0.12:4200","prod":"https://author.example.com"}
# DINGTALK_LOGIN_AUTH_URL is only a legacy/manual fallback; normal browser
# login builds the authorization URL server-side.
DINGTALK_LOGIN_AUTH_URL=

# Optional comment @mention work notifications. These settings are independent
# from browser login; viewer-site remains anonymous/public.
DINGTALK_COMMENT_NOTIFICATIONS_ENABLED=false
DINGTALK_AGENT_ID=
# Must be a public HTTPS viewer origin in production, without a trailing slash.
DINGTALK_COMMENT_VIEWER_BASE_URL=
# Required for anonymous notification rate-limit IP digests. Use a separate secret.
DINGTALK_COMMENT_RATE_LIMIT_SECRET=
# Anonymous notifications/search fail closed unless the reverse proxy replaces
# this client-IP header and trust is explicitly enabled.
DINGTALK_COMMENT_TRUST_PROXY=false
DINGTALK_COMMENT_CLIENT_IP_HEADER=x-forwarded-for
# Optional anonymous notification/search threshold overrides.
DINGTALK_COMMENT_ANONYMOUS_10M_LIMIT=10
DINGTALK_COMMENT_ANONYMOUS_24H_LIMIT=30
DINGTALK_COMMENT_RECIPIENT_HOURLY_LIMIT=5
DINGTALK_COMMENT_PROJECT_HOURLY_LIMIT=100
DINGTALK_COMMENT_SEARCH_PER_MINUTE_LIMIT=30
DINGTALK_COMMENT_CIRCUIT_FAILURE_LIMIT=20
DINGTALK_COMMENT_CIRCUIT_WINDOW_MS=300000
DINGTALK_COMMENT_CIRCUIT_OPEN_MS=600000

# Optional Figma OAuth for user-level Figma MCP authorization.
# Create a Figma OAuth app and set the redirect URI to:
# http://localhost:4200/api/user/external-auth/figma/callback
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REDIRECT_URI=http://localhost:4200/api/user/external-auth/figma/callback
# Optional: where the browser returns after OAuth. Useful when redirect URI uses a public tunnel.
# FIGMA_OAUTH_POST_AUTH_ORIGIN=http://localhost:4200
# Optional cross-environment OAuth handoff. Use one fixed callback URL and a
# shared server-only secret across environments.
# FIGMA_OAUTH_TARGET_ID=dev
# FIGMA_OAUTH_HANDOFF_SECRET=
# FIGMA_OAUTH_TARGETS_JSON={"dev":"http://10.0.0.11:4200","test":"http://10.0.0.12:4200"}
# FIGMA_OAUTH_SCOPES=file_content:read

# Use false for local HTTP development.
USE_SECURE_COOKIE=false

# Optional data directory override. Defaults to ./data when unset.
# DATA_DIR=./data

# Public OneFlow homepage used by brand links in both web apps.
# NEXT_PUBLIC_AUTHOR_SITE_URL=https://your-oneflow-domain.example

# ============================================
# agent-service
# ============================================

HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200,http://127.0.0.1:4300

# Required only when running real Pi Agent calls.
PI_AGENT_API_KEY=
PI_AGENT_PROVIDER=jojo
PI_AGENT_MODEL=deepseek-v4-flash
PI_AGENT_BASE_URL=
PI_AGENT_TIMEOUT=120000

# Optional subagent controls.
PI_AGENT_SUBAGENTS_ENABLED=true
PI_AGENT_SUBAGENT_TIMEOUT=120000

# Optional web page reading tool. Enabled by default; set to false to disable public URL reads.
PI_AGENT_WEB_READ_ENABLED=true
PI_AGENT_WEB_READ_TIMEOUT_MS=10000
PI_AGENT_WEB_READ_MAX_BYTES=1000000

# Optional web search tool. Requires a Brave Search API key.
PI_AGENT_WEB_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
PI_AGENT_WEB_SEARCH_TIMEOUT_MS=10000
PI_AGENT_WEB_SEARCH_CACHE_TTL_MS=600000

# Optional Figma MCP endpoint override. Defaults to https://mcp.figma.com/mcp when unset.
# FIGMA_MCP_URL=https://mcp.figma.com/mcp
# FIGMA_MCP_REGION=

# ============================================
# screenshot-service
# ============================================

AUTHOR_SITE_URL=http://localhost:4200

# Required only when Puppeteer cannot auto-detect a local browser.
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ============================================
# viewer-site
# ============================================

NEXT_PUBLIC_DATA_BASE=http://localhost:4200
# NEXT_PUBLIC_AUTHOR_SITE_URL=http://localhost:4200

# ============================================
# E2E
# ============================================

E2E_BASE_URL=http://localhost:4200
E2E_USER=test
E2E_PASSWORD=

# ============================================
# Optional OSS publish assets
# ============================================

# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=opencode-workbench-assets
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_PATH_PREFIX=projects
