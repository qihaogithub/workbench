interface Position {
  x: number;
  y: number;
}

interface BlockItem {
  image: string;
  position: Position;
  replacedImage?: string;
}

interface DemoProps {
  backgroundImage?: string;
  blanks?: BlockItem[];
  options?: BlockItem[];
  mode?: string;
}

const IMAGE_SIZE = 195;

export default function Demo({
  backgroundImage = "https://img.onlywnn.cn/figma/h_dc3eff70.png",
  blanks = [],
  options = [],
  mode = "replace-option",
}: DemoProps) {
  const blankSrc = (block: BlockItem, index: number) => {
    if (mode === "replace-image") {
      return block.replacedImage || block.image;
    }
    return options[index]?.image || block.image;
  };

  return (
    <div
      data-layer="拖动前"
      style={{
        width: 1920,
        height: 1080,
        position: "relative",
        background: "#BCBCBC",
        overflow: "hidden",
      }}
    >
      {/* 背景图 */}
      <img
        alt="static layer"
        data-layer="#static 背景图"
        src={backgroundImage}
        style={{
          left: 0,
          top: 0,
          position: "absolute",
          width: 1920,
          height: 1080,
          objectFit: "cover",
        }}
      />

      {/* 空 */}
      {blanks.map((block, index) => (
        <img
          key={`blank-${index}`}
          alt="static layer"
          data-pos-key="blank"
          data-layer={`空${index + 1}`}
          src={blankSrc(block, index)}
          style={{
            left: block.position.x,
            top: block.position.y,
            position: "absolute",
            width: IMAGE_SIZE,
            height: IMAGE_SIZE,
            objectFit: "cover",
          }}
        />
      ))}

      {/* 选项 */}
      {options.map((block, index) => (
        <img
          key={`option-${index}`}
          alt="static layer"
          data-pos-key="option"
          data-layer={`选项${index + 1}`}
          src={block.image}
          style={{
            left: block.position.x,
            top: block.position.y,
            position: "absolute",
            width: IMAGE_SIZE,
            height: IMAGE_SIZE,
            objectFit: "cover",
          }}
        />
      ))}

      {/* 游戏导航-横屏 */}
      <div
        data-layer="游戏导航-横屏"
        data-导航类型="题目型&图标按钮"
        data-打星="true"
        data-提交按钮="false"
        style={{
          width: 1440,
          paddingLeft: 12,
          paddingRight: 12,
          paddingTop: 8,
          paddingBottom: 8,
          left: 240,
          top: 136,
          position: "absolute",
          justifyContent: "space-between",
          alignItems: "flex-start",
          display: "flex",
        }}
      >
        <div
          data-layer="左侧布局"
          style={{
            width: 210,
            height: 120,
            flexShrink: 0,
            position: "relative",
            justifyContent: "flex-start",
            alignItems: "center",
            display: "flex",
          }}
        >
          <img
            alt="static layer"
            data-layer="#static 导航按钮-游戏"
            data-功能="返回"
            data-状态="唤醒"
            src="https://img.onlywnn.cn/figma/h_e1db4998.png"
            style={{
              position: "relative",
              width: 120,
              height: 120,
              objectFit: "cover",
            }}
          />
        </div>
        <div
          data-layer="题目-横屏"
          style={{
            flexShrink: 0,
            paddingTop: 22,
            paddingBottom: 22,
            position: "relative",
            flexDirection: "column",
            justifyContent: "center",
            alignItems: "center",
            display: "flex",
          }}
        >
          <div
            data-layer="题目-横屏"
            data-头像="false"
            style={{
              flexShrink: 0,
              position: "relative",
              justifyContent: "center",
              alignItems: "flex-start",
              gap: 16,
              display: "flex",
            }}
          >
            <div
              data-layer="题目-横屏"
              data-语音="true"
              style={{
                flexShrink: 0,
                paddingLeft: 36,
                paddingRight: 36,
                position: "relative",
                background: "white",
                boxShadow: "0px 8px 16px rgba(0, 0, 0, 0.12)",
                borderRadius: 38,
                justifyContent: "flex-start",
                alignItems: "flex-start",
                gap: 40,
                display: "flex",
              }}
            >
              <div
                data-layer="Frame 1"
                style={{
                  flexShrink: 0,
                  position: "relative",
                  justifyContent: "center",
                  alignItems: "center",
                  gap: 10,
                  display: "flex",
                }}
              >
                <div
                  data-layer="语音"
                  data-声音状态="大声"
                  style={{
                    width: 60,
                    height: 60,
                    flexShrink: 0,
                    position: "relative",
                  }}
                >
                  <img
                    alt="vector"
                    data-layer="Vector"
                    src="https://img.onlywnn.cn/figma/h_23a93235.svg"
                    style={{
                      left: 2.5,
                      top: 16.36,
                      position: "absolute",
                      width: 13,
                      height: 25,
                      objectFit: "contain",
                    }}
                  />
                  <img
                    alt="vector"
                    data-layer="Vector"
                    src="https://img.onlywnn.cn/figma/h_b2472e46.svg"
                    style={{
                      left: 10,
                      top: 4.97,
                      position: "absolute",
                      width: 25,
                      height: 48,
                      objectFit: "contain",
                    }}
                  />
                  <img
                    alt="vector"
                    data-layer="Vector"
                    src="https://img.onlywnn.cn/figma/h_2d031a76.svg"
                    style={{
                      left: 37.48,
                      top: 10.54,
                      position: "absolute",
                      width: 20,
                      height: 37,
                      objectFit: "contain",
                    }}
                  />
                </div>
                <div
                  data-layer="文字-横屏"
                  data-property-1="23字以内"
                  style={{
                    flexShrink: 0,
                    paddingTop: 20,
                    paddingBottom: 20,
                    position: "relative",
                    justifyContent: "flex-start",
                    alignItems: "flex-start",
                    gap: 10,
                    display: "flex",
                  }}
                >
                  <div
                    style={{
                      flexShrink: 0,
                      justifyContent: "center",
                      display: "flex",
                      flexDirection: "column",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                      whiteSpace: "nowrap",
                      color: "#544300",
                      fontSize: 36,
                      fontFamily: "PingFang SC",
                      fontWeight: 500,
                      lineHeight: "36px",
                    }}
                  >
                    请拖动八个红苹果四个绿苹果到水果盘四个绿苹果到水。
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          data-layer="右侧布局"
          style={{
            width: 210,
            height: 120,
            flexShrink: 0,
            paddingRight: 8,
            position: "relative",
            justifyContent: "flex-end",
            alignItems: "center",
            display: "flex",
          }}
        />
      </div>
    </div>
  );
}
