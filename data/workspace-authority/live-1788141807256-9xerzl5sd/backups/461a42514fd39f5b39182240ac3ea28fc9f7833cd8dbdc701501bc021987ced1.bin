{
  "type": "object",
  "properties": {
    "backgroundImage": {
      "type": "string",
      "format": "image",
      "title": "背景图",
      "default": "https://img.onlywnn.cn/figma/h_dc3eff70.png",
      "ui:options": {
        "minWidth": 1920,
        "minHeight": 1080,
        "widthRule": {
          "operator": "=",
          "value": 1920
        },
        "heightRule": {
          "operator": "=",
          "value": 1080
        }
      }
    },
    "mode": {
      "type": "string",
      "title": "模式选择",
      "enum": [
        "replace-option",
        "replace-image"
      ],
      "enumNames": [
        "替换为选项图",
        "替换为另一张图"
      ],
      "default": "replace-option"
    },
    "blanks": {
      "type": "array",
      "title": "空",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "image",
            "title": "图片"
          },
          "replacedImage": {
            "type": "string",
            "format": "image",
            "title": "替换后的图"
          },
          "position": {
            "type": "position",
            "key": "blank",
            "title": "位置",
            "size": {
              "width": 1920,
              "height": 1080
            },
            "default": {
              "x": 722,
              "y": 316
            }
          }
        },
        "required": [
          "image",
          "position"
        ]
      },
      "default": [
        {
          "image": "https://img.onlywnn.cn/figma/h_dfd47404.png",
          "replacedImage": "",
          "position": {
            "x": 722,
            "y": 316
          }
        },
        {
          "image": "https://img.onlywnn.cn/figma/h_dfd47404.png",
          "replacedImage": "",
          "position": {
            "x": 1002,
            "y": 316
          }
        }
      ]
    },
    "options": {
      "type": "array",
      "title": "选项",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "image",
            "title": "图片"
          },
          "position": {
            "type": "position",
            "key": "option",
            "title": "位置",
            "size": {
              "width": 1920,
              "height": 1080
            },
            "default": {
              "x": 579,
              "y": 612
            }
          }
        },
        "required": [
          "image",
          "position"
        ]
      },
      "default": [
        {
          "image": "https://img.onlywnn.cn/figma/h_d59a9b95.png",
          "position": {
            "x": 579,
            "y": 612
          }
        },
        {
          "image": "https://img.onlywnn.cn/figma/h_c56dd669.png",
          "position": {
            "x": 863,
            "y": 612
          }
        },
        {
          "image": "https://img.onlywnn.cn/figma/h_d9b8d53a.png",
          "position": {
            "x": 1145,
            "y": 612
          }
        }
      ]
    }
  },
  "$demo": {
    "presentation": {
      "version": 1,
      "mode": "fixed-canvas",
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "heightBehavior": "fixed",
      "preset": "custom",
      "source": "figma"
    }
  }
}