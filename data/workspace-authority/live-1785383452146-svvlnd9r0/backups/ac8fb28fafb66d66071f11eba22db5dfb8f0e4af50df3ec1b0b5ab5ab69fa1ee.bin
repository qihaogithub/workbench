{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "配置项类型展示",
  "type": "object",
  "$demo": {
    "previewSize": {
      "width": 375,
      "height": 812
    }
  },
  "properties": {
    "pageTitle": {
      "type": "string",
      "title": "页面标题",
      "default": "配置项类型全览"
    },
    "discount": {
      "type": "number",
      "title": "折扣力度（%）",
      "default": 85
    },
    "showBanner": {
      "type": "boolean",
      "title": "是否展示横幅",
      "default": true
    },
    "author": {
      "type": "object",
      "title": "作者信息",
      "properties": {
        "name": {
          "type": "string",
          "title": "作者名",
          "default": "设计师小张"
        },
        "level": {
          "type": "integer",
          "title": "等级",
          "default": 5
        }
      },
      "default": {
        "name": "设计师小张",
        "level": 5
      }
    },
    "tags": {
      "type": "array",
      "title": "标签列表",
      "items": {
        "type": "string"
      },
      "default": ["新品", "限时", "爆款"]
    },
    "primaryColor": {
      "type": "string",
      "title": "主色调",
      "format": "color",
      "default": "#FF6B35"
    },
    "secondaryColor": {
      "type": "string",
      "title": "辅助色",
      "format": "color",
      "default": "#004E89"
    },
    "bannerImage": {
      "type": "string",
      "title": "横幅图片",
      "format": "image",
      "default": ""
    },
    "theme": {
      "type": "string",
      "title": "主题风格",
      "enum": ["dark", "light", "colorful", "minimal"],
      "enumNames": ["深色", "浅色", "多彩", "极简"],
      "default": "dark"
    },
    "modules": {
      "type": "array",
      "title": "内容模块",
      "items": {
        "oneOf": [
          {
            "title": "图片模块",
            "properties": {
              "type": { "const": "image" },
              "imageUrl": {
                "type": "string",
                "format": "image",
                "title": "图片"
              },
              "caption": {
                "type": "string",
                "title": "图片说明",
                "default": "图片模块示例"
              }
            },
            "required": ["type"]
          },
          {
            "title": "文字模块",
            "properties": {
              "type": { "const": "text" },
              "content": {
                "type": "string",
                "title": "文本内容",
                "default": "这是一段文字模块的内容"
              },
              "fontSize": {
                "type": "number",
                "title": "字号（px）",
                "default": 16
              }
            },
            "required": ["type"]
          },
          {
            "title": "视频模块",
            "$demo": { "maxItems": 1 },
            "properties": {
              "type": { "const": "video" },
              "videoCover": {
                "type": "string",
                "format": "image",
                "title": "视频封面"
              },
              "title": {
                "type": "string",
                "title": "视频标题",
                "default": "视频模块示例"
              }
            },
            "required": ["type"]
          }
        ]
      },
      "default": [
        { "type": "image", "imageUrl": "", "caption": "图片模块示例" },
        { "type": "text", "content": "这是一段文字模块的内容", "fontSize": 16 },
        { "type": "video", "videoCover": "", "title": "视频模块示例" }
      ]
    }
  },
  "required": []
}
