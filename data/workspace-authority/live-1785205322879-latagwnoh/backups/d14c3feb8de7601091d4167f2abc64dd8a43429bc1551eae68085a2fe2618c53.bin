{
  "type": "object",
  "properties": {
    "bgm": {
      "type": "string",
      "format": "file",
      "title": "闯关背景音乐",
      "description": "仅支持 MP3 格式，文件大小需小于 1M",
      "ui:options": {
        "accept": "audio/mpeg,.mp3"
      },
      "default": ""
    },
    "navColor": {
      "type": "string",
      "format": "color",
      "title": "导航栏颜色",
      "default": "#C4C4C4"
    },
    "modules": {
      "type": "array",
      "title": "内容模块",
      "$demo": {
        "sortable": true
      },
      "items": {
        "oneOf": [
          {
            "title": "图片模块",
            "properties": {
              "type": {
                "const": "image"
              },
              "image": {
                "type": "string",
                "format": "image",
                "title": "图片",
                "accept": "image/png,image/gif"
              }
            },
            "required": [
              "type",
              "image"
            ]
          },
          {
            "title": "参与人数模块",
            "$demo": {
              "maxItems": 1
            },
            "properties": {
              "type": {
                "const": "participant"
              },
              "bgImage": {
                "type": "string",
                "format": "image",
                "title": "参与人数背景图",
                "accept": "image/png"
              },
              "count": {
                "type": "number",
                "title": "参与人数",
                "default": 0
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "title": "视频模块",
            "$demo": {
              "maxItems": 1
            },
            "properties": {
              "type": {
                "const": "video"
              },
              "videoBg": {
                "type": "string",
                "format": "image",
                "title": "视频背景图",
                "accept": "image/png"
              },
              "video": {
                "type": "object",
                "title": "视频",
                "format": "video",
                "properties": {
                  "url": {
                    "type": "string",
                    "title": "视频地址"
                  },
                  "poster": {
                    "type": "string",
                    "title": "封面地址",
                    "format": "image"
                  }
                },
                "required": [
                  "url"
                ],
                "ui:options": {
                  "accept": "video/mp4,video/webm",
                  "videoPreviewStyle": "controls"
                }
              }
            },
            "required": [
              "type",
              "video"
            ]
          }
        ]
      },
      "default": [
        {
          "type": "participant",
          "bgImage": "https://img.onlywnn.cn/figma/h_19dbcc85.png",
          "count": 128
        },
        {
          "type": "video",
          "videoBg": "",
          "video": {
            "url": "",
            "poster": ""
          }
        },
        {
          "type": "image",
          "image": "https://img.onlywnn.cn/figma/h_483ae3df.png"
        }
      ]
    }
  },
  "$demo": {
    "presentation": {
      "version": 1,
      "mode": "fixed-canvas",
      "viewport": {
        "width": 375,
        "height": 812
      },
      "heightBehavior": "fixed",
      "preset": "custom",
      "source": "figma"
    }
  }
}
