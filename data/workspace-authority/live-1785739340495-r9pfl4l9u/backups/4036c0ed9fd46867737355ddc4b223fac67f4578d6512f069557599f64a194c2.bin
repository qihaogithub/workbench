interface DemoProps {}

// 各科目头图默认背景（750×540，与项目配置默认一致，配置面板 activeSubject + headerBg{科目} 可覆盖）
const HEADER_DEFAULTS: Record<string, string> = {
  reading: '/api/images/img_58Nvlmtce0YIpQ',
  thinking: '/api/images/img_1CNWpq51stui3Q',
  aesthetic: '/api/images/img_7EYcNE_vqIGKcQ',
  english: '/api/images/img_IoWnJYEMC0NyDg',
  writer: '/api/images/img_9svWLq4_hZ0KsQ',
};

// 各科目完课进度背景（与项目配置默认一致，配置面板 progressBg{科目} 可覆盖）
const PROGRESS_DEFAULTS: Record<string, string> = {
  reading: '/api/images/img_5dPgaXqQz3QwQw',
  thinking: '/api/images/img_U36XTEX5p93-EA',
  aesthetic: '/api/images/img_LxDILgDuc6rE7Q',
  english: '/api/images/img_XMB2iQfiivmpFA',
  writer: '/api/images/img_1maztsLNuShKfQ',
};

// 各科目主题色板（与设计色卡一一对应，随 activeSubject 切换）
// light=浅底/描边内衬, border=焦点描边, mid=状态点, main=主色文本, dark=深色文本
const SUBJECT_PALETTES: Record<string, { light: string; border: string; mid: string; main: string; dark: string }> = {
  reading: { light: '#FFEBDE', border: '#FFA66B', mid: '#FF9045', main: '#E35B00', dark: '#6B2D03' },
  thinking: { light: '#DBF3FF', border: '#87D7FF', mid: '#33BBFF', main: '#0090D9', dark: '#0C567A' },
  english: { light: '#FFDBE4', border: '#FF9EB5', mid: '#FF7A99', main: '#CC2D52', dark: '#780A23' },
  writer: { light: '#D2F7C6', border: '#A0D98D', mid: '#5DC43B', main: '#4AA12D', dark: '#155200' },
  aesthetic: { light: '#F3EBFC', border: '#C8A0FA', mid: '#AE84E3', main: '#8D4BDE', dark: '#4E2680' },
};

function cap(key: string) {
  return key.charAt(0).toUpperCase() + key.slice(1);
}

export default function CourseCompleteActivity(props: DemoProps) {
  const p = props as Record<string, unknown>;
  const subject = (p.activeSubject as string) || 'reading';
  const bg =
    (p[`headerBg${cap(subject)}`] as string) || HEADER_DEFAULTS[subject] || '';
  const progressBg =
    (p[`progressBg${cap(subject)}`] as string) || PROGRESS_DEFAULTS[subject] || '';
  const pal = SUBJECT_PALETTES[subject] || SUBJECT_PALETTES.thinking;

  return (
    <div
      style={{
        width: 375,
        height: 812,
        position: 'relative',
        background: 'white',
        overflow: 'hidden',
      }}
    >
      {/* 第 1 层：头部背景（750×540，宽度撑满，高度按原比例 270px，顶部对齐，由配置 activeSubject + headerBg{科目} 驱动） */}
      {bg ? (
        <img
          src={bg}
          alt={`${subject}头部背景`}
          style={{ left: 0, top: 0, position: 'absolute', width: 375, height: 270, objectFit: 'cover' }}
        />
      ) : null}

      {/* 状态栏 */}
      <div style={{ width: 375, height: 44, left: 0, top: 0, position: 'absolute' }}>
        <div style={{ width: 375, height: 44, left: 0, top: 0, position: 'absolute' }} />
        <img
          src="/api/images/img_JZ8v8Mk1UqiAyw"
          alt="状态栏信号与电量"
          style={{ left: 293.67, top: 17.33, position: 'absolute', width: 67, height: 11, objectFit: 'contain' }}
        />
        <img
          src="/api/images/img_BaMdiXq1aEcuzg"
          alt="时间"
          style={{ left: 20.6, top: 16.81, position: 'absolute', width: 24, height: 10, objectFit: 'contain' }}
        />
      </div>

      {/* 连续学 */}
      <img
        src="/api/images/img_CjfDGmUT0y3vKQ"
        alt="连续学"
        style={{ left: 14, top: 103, position: 'absolute', width: 163, height: 88, objectFit: 'cover' }}
      />
      {/* 角色 */}
      <img
        src="/api/images/img_mZI86hCZSbzPVA"
        alt="角色"
        style={{ left: 200, top: 80, position: 'absolute', width: 185, height: 222, objectFit: 'cover' }}
      />
      {/* 学科tab */}
      <img
