// 进度节点（已完成/未完成）
function renderProgressNode(left: number, stateText: string, value: string, isDone: boolean, pal: { light: string; border: string; mid: string; main: string; dark: string }) {
  return (
    <div style={{ left, top: -2, position: 'absolute', flexDirection: 'column', justifyContent: 'flex-start', alignItems: 'flex-start', display: 'inline-flex' }}>
      <div style={{ width: 24, height: 24, flexShrink: 0, position: 'relative', overflow: 'hidden' }}>
        {isDone ? (
          <div style={{ width: 16, height: 16, left: 4, top: 4, position: 'absolute' }}>
            <div style={{ width: 16, height: 16, left: 0, top: 0, position: 'absolute', background: pal.mid, borderRadius: 9999, outline: '1.5px solid white' }} />
            <img src="/api/images/img_OnX4S1pJumYSXg" alt="盖章" style={{ left: 3, top: 4, position: 'absolute', width: 10, height: 9, objectFit: 'contain' }} />
          </div>
        ) : (
          <div style={{ width: 15.92, height: 16.92, left: 4, top: 2, position: 'absolute' }}>
            <img src="/api/images/img_e_qjOlLFXJ4DHg" alt="" style={{ left: 0, top: 0.26, position: 'absolute', width: 16, height: 17, objectFit: 'contain' }} />
            <img src="/api/images/img_NAY_Yur-yX91JQ" alt="" style={{ left: 0.8, top: 4.78, position: 'absolute', width: 14, height: 12, objectFit: 'contain' }} />
            <img src="/api/images/img_QiicMZTXDIFiDg" alt="" style={{ left: 6.11, top: 8.23, position: 'absolute', width: 4, height: 9, objectFit: 'contain' }} />
            <img src="/api/images/img_iMwnQvIhuGE7lw" alt="" style={{ left: 7.43, top: 0, position: 'absolute', width: 7, height: 4, objectFit: 'contain' }} />
            <img src="/api/images/img_I2iybgpcYQxGfg" alt="" style={{ left: 8.49, top: 3.98, position: 'absolute', width: 7, height: 4, objectFit: 'contain' }} />
            <div style={{ width: 15.92, height: 4.25, left: 0, top: 3.98, position: 'absolute', background: '#FF9751', borderRadius: 0.47 }} />
            <img src="/api/images/img_R-ECKWAjftQ96w" alt="" style={{ left: 6.24, top: 2.39, position: 'absolute', width: 4, height: 2, objectFit: 'contain' }} />
            <img src="/api/images/img_HdRQu5VSfnE_Bw" alt="" style={{ left: 5.84, top: 3.98, position: 'absolute', width: 4, height: 4, objectFit: 'contain' }} />
          </div>
        )}
      </div>
      <div style={{ alignSelf: 'stretch', flexShrink: 0, opacity: 0.3, textAlign: 'center', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', color: pal.dark, fontSize: 12, fontFamily: 'MohrRounded-SemiBold', fontWeight: 400, lineHeight: '18px' }}>{value}</div>
    </div>
  );
}

// 锁定的课时行
function renderLockedRow(cover: string, orderText: string, nameText: string, upImg: string, downImg: string) {
  return (
    <div style={{ width: 335, flexShrink: 0, paddingTop: 8, paddingBottom: 8, position: 'relative', justifyContent: 'flex-start', alignItems: 'center', gap: 4, display: 'inline-flex' }}>
      <img src={upImg} alt="" style={{ left: 14, top: 0, position: 'absolute', width: 0, height: 49, objectFit: 'contain' }} />
      <img src={downImg} alt="" style={{ left: 14, top: 47, position: 'absolute', width: 0, height: 37, objectFit: 'contain' }} />
      <div style={{ width: 28, height: 28, flexShrink: 0, position: 'relative' }}>
        <div style={{ width: 28, height: 28, left: 0, top: 0, position: 'absolute' }}>
          <img src="/api/images/img__E0ZvuSG5y2lTw" alt="" style={{ left: 2.33, top: 2.33, position: 'absolute', width: 23, height: 23, objectFit: 'contain' }} />
          <img src="/api/images/img_nmdBWxxZMn1uZw" alt="" style={{ left: 8.17, top: 6.81, position: 'absolute', width: 12, height: 13, objectFit: 'contain' }} />
          <div style={{ width: 28, height: 28, left: 0, top: 0, position: 'absolute', background: 'rgba(0,0,0,0)' }} />
        </div>
        <div style={{ width: 25, left: 2, top: 20, position: 'absolute', background: 'white', borderRadius: 15, justifyContent: 'center', alignItems: 'center', gap: 5, display: 'inline-flex' }}>
          <div style={{ flexShrink: 0, textAlign: 'center', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', color: '#B2B2B2', fontSize: 10, fontFamily: 'PingFang SC', fontWeight: 400, lineHeight: '15px' }}>2.23</div>
        </div>
      </div>
      <div style={{ width: 300, flexShrink: 0, padding: 14, position: 'relative', background: 'white', borderRadius: 24, justifyContent: 'flex-start', alignItems: 'center', gap: 4, display: 'flex' }}>
        <div style={{ flexGrow: 1, flexBasis: 0, minWidth: 0, position: 'relative', justifyContent: 'flex-start', alignItems: 'center', gap: 8, display: 'flex' }}>
          <div style={{ width: 40, height: 40, flexShrink: 0, position: 'relative' }}>
            <img src={cover} alt="课时封面" style={{ width: 40, height: 40, left: 0, top: 0, position: 'absolute', borderRadius: 6.95, border: '0.58px solid rgba(0,0,0,0.10)' }} />
          </div>
          <div style={{ width: 140, flexShrink: 0, position: 'relative', flexDirection: 'column', justifyContent: 'flex-start', alignItems: 'flex-start', display: 'inline-flex' }}>
            <div style={{ alignSelf: 'stretch', flexShrink: 0, position: 'relative', flexDirection: 'column', justifyContent: 'center', alignItems: 'flex-start', gap: 2, display: 'flex' }}>
              <div style={{ flexShrink: 0, position: 'relative', justifyContent: 'flex-start', alignItems: 'flex-start', gap: 2, display: 'inline-flex' }}>
                <div style={{ flexShrink: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', color: '#B2B2B2', fontSize: 16, fontFamily: 'PingFang SC', fontWeight: 500, lineHeight: '24px' }}>{orderText}</div>
                <div style={{ flexShrink: 0, display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical', overflow: 'hidden', color: '#B2B2B2', fontSize: 16, fontFamily: 'PingFang SC', fontWeight: 500, lineHeight: '24px', whiteSpace: 'nowrap' }}>{nameText}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}