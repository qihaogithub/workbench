      {/* 课后菜单 */}
      <img src="/api/images/img_HCkR71v-niHXzw" alt="课后菜单" style={{ left: 341, top: 638.5, position: 'absolute', width: 34, height: 40, objectFit: 'cover' }} />
      {/* 吸底标签栏 */}
      <img src="/api/images/img_RDwV0uzhYNVR1w" alt="吸底标签栏" style={{ left: 0, top: 722, position: 'absolute', width: 375, height: 90, objectFit: 'cover' }} />
    </div>
  );
}

