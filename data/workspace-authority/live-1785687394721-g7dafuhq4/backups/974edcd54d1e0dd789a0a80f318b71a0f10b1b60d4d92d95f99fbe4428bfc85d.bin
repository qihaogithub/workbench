* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  background: #f3f4f6;
  color: #1f2937;
}

.page {
  width: 100%;
  min-height: 100vh;
  max-width: 100%;
  padding-bottom: 32px;
}

/* ===== 顶部 Hero ===== */
.hero {
  padding: 40px 24px 32px;
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 55%, #a855f7 100%);
}

.hero-badge {
  display: inline-block;
  padding: 4px 12px;
  margin-bottom: 12px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  color: #ede9fe;
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
}

.hero h1 {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.hero-sub {
  margin-top: 8px;
  font-size: 13px;
  opacity: 0.85;
}

/* ===== 区块 ===== */
.section {
  padding: 20px 16px 0;
}

.section-title {
  margin-bottom: 12px;
  font-size: 13px;
  font-weight: 600;
  color: #6b7280;
  letter-spacing: 1px;
}

/* ===== 卡片 ===== */
.card {
  margin-bottom: 12px;
  padding: 14px 16px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.card-border {
  border-width: 2px;
}

.card-bg {
  border-color: transparent;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.card-head code {
  font-size: 12px;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 2px 8px;
  border-radius: 6px;
}

/* ===== 类型标签 ===== */
.tag {
  display: inline-block;
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 600;
  border-radius: 999px;
}

.tag-string { color: #0e7490; background: #cffafe; }
.tag-number { color: #b45309; background: #fef3c7; }
.tag-enum   { color: #7c3aed; background: #ede9fe; }
.tag-color  { color: #be185d; background: #fce7f3; }
.tag-image  { color: #15803d; background: #dcfce7; }
.tag-link   { color: #1d4ed8; background: #dbeafe; }

/* ===== 值展示 ===== */
.value {
  font-size: 14px;
  color: #374151;
  line-height: 1.6;
}

.value strong {
  color: #1f2937;
  font-weight: 700;
}

.value-xl {
  font-size: 18px;
  font-weight: 700;
  color: #111827;
}

.text-body {
  font-size: 13px;
  color: #4b5563;
}

.value-theme {
  font-weight: 700;
  font-size: 15px;
}

.row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.swatch {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

/* ===== 图片 ===== */
.avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #e5e7eb;
  display: block;
}

.banner {
  width: 100%;
  height: 120px;
  border-radius: 10px;
  object-fit: cover;
  display: block;
}

/* ===== 链接 ===== */
.link {
  display: inline-block;
  font-size: 14px;
  font-weight: 600;
  color: #6366f1;
  text-decoration: none;
  border-bottom: 2px solid #c7d2fe;
  padding-bottom: 2px;
}

/* ===== 页脚 ===== */
.footer {
  margin-top: 24px;
  padding: 0 16px;
  text-align: center;
  font-size: 12px;
  color: #9ca3af;
}
