* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: #f5f5f5;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 24px 16px;
}

.container {
  width: 100%;
  max-width: 343px;
}

.card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.card-header {
  padding: 20px 20px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 20px;
  font-weight: 600;
  color: #fff;
  line-height: 1.3;
}

.badge {
  font-size: 11px;
  font-weight: 500;
  color: #fff;
  padding: 3px 10px;
  border-radius: 20px;
  opacity: 0.9;
  white-space: nowrap;
}

.card-body {
  padding: 16px 20px 20px;
}

.card-image {
  width: 100%;
  height: 160px;
  background: #f0f0f0;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.card-image img:not([src]), 
.card-image img[src=""] {
  opacity: 0;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-label {
  font-size: 13px;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  font-size: 14px;
  color: #333;
  text-align: right;
  max-width: 70%;
  word-break: break-all;
}

.info-desc .info-value {
  line-height: 1.5;
}

.card-footer {
  padding: 12px 20px;
  background: #fafafa;
  text-align: center;
}

.footer-hint {
  font-size: 12px;
  color: #bbb;
}