  title?: string;
  description?: string;
  count?: number;
  level?: number;
  enabled?: boolean;
  bgColor?: string;
  accentColor?: string;
  coverImage?: string;
  gallery?: string[];
  mode?: string;
  tags?: string[];
  region?: string[];
  richtextContent?: string;
  badgePosition?: { x: number; y: number };
  modules?: Array<Record<string, unknown>>;
