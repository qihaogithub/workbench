<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Group 2424</title>
  <style>
    /* Reset default margins */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 20px;
      background-color: #f5f5f5;
    }
    
    /* Figma export container */
    .figma-export {
      background: white;
      width: 375px;
      height: 812px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body>
  <div class="figma-export">
<div data-layer="Group 2424" class="Group2424" style="width: 375px; height: 812px; position: relative">
  <img data-layer="学习页 1" class="1" style="width: 375px; height: 812px; left: 0px; top: 0px; position: absolute" src="https://img.onlywnn.cn/figma/h_528d8a7b.png" />
  <div data-layer="Rectangle 3611568" class="Rectangle3611568" style="width: 153px; height: 22px; left: 115px; top: 790px; position: absolute; background: white"></div>
</div>
  </div>
</body>
</html>