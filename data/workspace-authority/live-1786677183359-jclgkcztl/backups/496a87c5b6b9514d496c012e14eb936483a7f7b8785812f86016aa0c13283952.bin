/* ============================================================
   黑白灰线框原型 · 成就海报生成 分享页
   ============================================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #f0f0f0;
  color: #2b2b2b;
  line-height: 1.6;
}

.wf-container {
  max-width: 390px;
  margin: 0 auto;
  background: #ffffff;
  min-height: 100vh;
  box-shadow: 0 0 24px rgba(0, 0, 0, 0.1);
}

/* ---------- 顶部 ---------- */
.wf-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid #e3e3e3;
}

.wf-topbar-step {
  font-size: 14px;
  font-weight: 700;
  color: #2b2b2b;
}

.wf-topbar-hint {
  font-size: 12px;
  color: #999;
}

/* ---------- 成功语 ---------- */
.wf-success {
  text-align: center;
  padding: 24px 18px 8px;
}

.wf-success-title {
  font-size: 26px;
  font-weight: 800;
  color: #1c1c1c;
  margin-bottom: 6px;
}

.wf-success-sub {
  font-size: 16px;
  color: #555;
  margin-bottom: 10px;
}

.wf-success-share {
  font-size: 13px;
  color: #888;
}

/* ---------- 海报预览 ---------- */
.wf-poster {
  padding: 18px;
}

.wf-poster-frame {
  border: 2px solid #2b2b2b;
  border-radius: 14px;
  padding: 20px 18px;
  background: #fafafa;
}

.wf-poster-title {
  text-align: center;
  font-size: 20px;
  font-weight: 800;
  color: #1c1c1c;
  letter-spacing: 2px;
  border-bottom: 2px solid #2b2b2b;
  padding-bottom: 12px;
  margin-bottom: 16px;
}

/* 精灵团聚 */
.wf-poster-sprites {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-bottom: 6px;
}

.wf-sprite {
  width: 40px;
  height: 40px;
  border: 1px dashed #b0b0b0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  background: #fff;
}

.wf-sprite-focus {
  border: 2px solid #2b2b2b;
  background: #eee;
}

.wf-poster-sprite-note {
  display: block;
  text-align: center;
  font-size: 11px;
  color: #777;
  margin-bottom: 16px;
}

/* 勋章区 */
.wf-poster-badge {
  text-align: center;
  border: 1px solid #dcdcdc;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 16px;
  background: #fff;
}

.wf-badge-title {
  display: inline-block;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  background: #5a5a5a;
  padding: 3px 12px;
  border-radius: 999px;
  margin-bottom: 8px;
}

.wf-badge-icons {
  font-size: 20px;
  letter-spacing: 4px;
  margin-bottom: 4px;
}

.wf-badge-note {
  font-size: 10px;
  color: #999;
}

/* 单词树 */
.wf-poster-words {
  border: 1px solid #dcdcdc;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 16px;
  background: #fff;
}

.wf-poster-words h4 {
  font-size: 13px;
  font-weight: 700;
  color: #2b2b2b;
  margin-bottom: 10px;
  text-align: center;
}

.wf-poster-word-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
}

.wf-poster-word-tags span {
  font-size: 11px;
  padding: 4px 8px;
  border: 1px solid #dcdcdc;
  border-radius: 999px;
  color: #555;
  background: #fafafa;
}

/* 跟唱截图 */
.wf-poster-song {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid #dcdcdc;
  border-radius: 12px;
  padding: 12px;
  background: #fff;
}

.wf-song-thumb {
  width: 52px;
  height: 52px;
  border: 1px dashed #b0b0b0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  background: #f5f5f5;
  flex-shrink: 0;
}

.wf-song-title {
  font-size: 14px;
  font-weight: 700;
  color: #2b2b2b;
}

.wf-song-sub {
  font-size: 11px;
  color: #777;
  margin-top: 2px;
}

/* ---------- 操作区 ---------- */
.wf-actions {
  padding: 22px 18px 30px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.wf-btn {
  display: block;
  width: 100%;
  padding: 14px;
  font-size: 15px;
  font-weight: 700;
  text-align: center;
  border-radius: 8px;
  cursor: pointer;
  border: none;
  font-family: inherit;
}

.wf-btn-primary {
  background: #2b2b2b;
  color: #ffffff;
}

.wf-btn-outline {
  background: #ffffff;
  color: #2b2b2b;
  border: 2px solid #2b2b2b;
}

.wf-actions-hint {
  text-align: center;
  font-size: 11px;
  color: #999;
  margin-top: 4px;
}
