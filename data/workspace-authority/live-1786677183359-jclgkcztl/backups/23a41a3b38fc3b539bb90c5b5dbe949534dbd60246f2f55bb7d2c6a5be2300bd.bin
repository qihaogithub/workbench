/* ============================================================
   黑白灰线框原型 · 第4关 线索点选
   ============================================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #f0f0f0;
  color: #2b2b2b;
  line-height: 1.6;
}

.wf-container {
  max-width: 390px;
  margin: 0 auto;
  background: #ffffff;
  min-height: 100vh;
  box-shadow: 0 0 24px rgba(0, 0, 0, 0.1);
}

/* ---------- 关卡头部 ---------- */
.wf-levelbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  border-bottom: 1px solid #e3e3e3;
}

.wf-back {
  width: 34px;
  height: 34px;
  border: 1px solid #dcdcdc;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #555;
  background: #fff;
}

.wf-levelbar-title {
  text-align: center;
}

.wf-levelbar-tag {
  display: inline-block;
  font-size: 10px;
  color: #666;
  background: #eee;
  padding: 2px 10px;
  border-radius: 999px;
  margin-bottom: 2px;
}

.wf-levelbar-title h1 {
  font-size: 17px;
  font-weight: 700;
  color: #1c1c1c;
}

.wf-levelbar-icon {
  font-size: 22px;
}

/* ---------- 游戏引导 ---------- */
.wf-guide {
  display: flex;
  gap: 14px;
  padding: 18px;
  align-items: center;
}

.wf-guide-icon {
  width: 52px;
  height: 52px;
  border: 1px dashed #b0b0b0;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  background: #f7f7f7;
  flex-shrink: 0;
}

.wf-guide-title {
  font-size: 15px;
  font-weight: 700;
  color: #1c1c1c;
  margin-bottom: 4px;
}

.wf-guide-desc {
  font-size: 13px;
  color: #666;
}

/* ---------- 进度条 ---------- */
.wf-progress {
  position: relative;
  margin: 0 18px 8px;
  height: 18px;
  border: 1px solid #dcdcdc;
  border-radius: 999px;
  background: #f5f5f5;
}

.wf-progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 999px;
  background: #2b2b2b;
}

.wf-progress-text {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 10px;
  color: #2b2b2b;
  line-height: 18px;
  font-weight: 600;
}

/* ---------- 游戏区 ---------- */
.wf-game {
  padding: 12px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.wf-game-card {
  border: 1px solid #dcdcdc;
  border-radius: 12px;
  padding: 14px;
  background: #fcfcfc;
}

.wf-game-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.wf-game-label {
  font-size: 11px;
  color: #888;
  background: #eee;
  padding: 2px 8px;
  border-radius: 999px;
}

.wf-game-progress {
  font-size: 11px;
  color: #666;
}

.wf-game-q {
  font-size: 13px;
  color: #555;
  margin-bottom: 12px;
}

.wf-game-map {
  position: relative;
  height: 160px;
  border: 1px dashed #b0b0b0;
  border-radius: 10px;
  background:
    repeating-linear-gradient(0deg, #f5f5f5, #f5f5f5 20px, #efefef 20px, #efefef 40px);
  margin-bottom: 12px;
}

.wf-game-item {
  position: absolute;
  width: 34px;
  height: 34px;
  border: 1px dashed #b0b0b0;
  border-radius: 8px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  transform: translate(-50%, -50%);
}

.wf-game-item-found {
  border: 1px solid #2b2b2b;
  background: #eee;
}

.wf-game-map-note {
  position: absolute;
  bottom: 6px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 10px;
  color: #999;
}

.wf-word-reveal-inline {
  text-align: left;
}

.wf-word-en {
  font-size: 20px;
  font-weight: 800;
  color: #1c1c1c;
}

.wf-word-cn {
  font-size: 13px;
  color: #777;
  margin-top: 2px;
}

/* ---------- 已收集单词卡 ---------- */
.wf-collected {
  padding: 18px;
}

.wf-collected-title {
  font-size: 14px;
  font-weight: 700;
  color: #2b2b2b;
  margin-bottom: 12px;
}

.wf-collected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.wf-tag {
  font-size: 12px;
  padding: 6px 12px;
  border: 1px solid #dcdcdc;
  border-radius: 999px;
  color: #666;
  background: #fafafa;
}

.wf-tag-active {
  border-color: #2b2b2b;
  color: #1c1c1c;
  font-weight: 600;
  background: #f2f2f2;
}

/* ---------- 底部 ---------- */
.wf-actions {
  padding: 22px 18px 30px;
  text-align: center;
}

.wf-btn {
  display: block;
  width: 100%;
  padding: 14px;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  border-radius: 8px;
  cursor: pointer;
  border: none;
  font-family: inherit;
}

.wf-btn-primary {
  background: #2b2b2b;
  color: #ffffff;
}

.wf-actions-hint {
  font-size: 11px;
  color: #999;
  margin-top: 12px;
}
