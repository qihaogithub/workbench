/* ============================================================
   黑白灰线框原型 · 第1关 精灵失踪线索站
   ============================================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #f0f0f0;
  color: #2b2b2b;
  line-height: 1.6;
}

.wf-container {
  max-width: 390px;
  margin: 0 auto;
  background: #ffffff;
  min-height: 100vh;
  box-shadow: 0 0 24px rgba(0, 0, 0, 0.1);
}

/* ---------- 关卡头部 ---------- */
.wf-levelbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  border-bottom: 1px solid #e3e3e3;
}

.wf-back {
  width: 34px;
  height: 34px;
  border: 1px solid #dcdcdc;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #555;
  background: #fff;
}

.wf-levelbar-title {
  text-align: center;
}

.wf-levelbar-tag {
  display: inline-block;
  font-size: 10px;
  color: #666;
  background: #eee;
  padding: 2px 10px;
  border-radius: 999px;
  margin-bottom: 2px;
}

.wf-levelbar-title h1 {
  font-size: 17px;
  font-weight: 700;
  color: #1c1c1c;
}

.wf-levelbar-icon {
  font-size: 22px;
}

/* ---------- 视频区 ---------- */
.wf-video {
  padding: 18px;
  border-bottom: 1px solid #e3e3e3;
}

.wf-video-frame {
  position: relative;
  height: 200px;
  border: 1px dashed #b0b0b0;
  border-radius: 12px;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.wf-video-play {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #2b2b2b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}

.wf-video-note {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 10px;
  color: #999;
}

.wf-video-info {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border: 1px solid #ececec;
  border-radius: 10px;
  background: #fafafa;
}

.wf-video-thumb {
  width: 46px;
  height: 46px;
  border: 1px dashed #b0b0b0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  background: #fff;
  flex-shrink: 0;
}

.wf-video-title {
  font-size: 14px;
  font-weight: 700;
  color: #2b2b2b;
  margin-bottom: 3px;
}

.wf-video-desc {
  font-size: 12px;
  color: #777;
}

/* ---------- 线索提问 ---------- */
.wf-quiz {
  padding: 22px 18px;
  border-bottom: 1px solid #e3e3e3;
}

.wf-section-title {
  font-size: 18px;
  font-weight: 700;
  color: #1c1c1c;
  margin-bottom: 4px;
}

.wf-quiz-tip {
  font-size: 12px;
  color: #999;
  margin-bottom: 16px;
}

.wf-quiz-card {
  border: 1px solid #dcdcdc;
  border-radius: 10px;
  padding: 14px;
  margin-bottom: 12px;
  background: #fcfcfc;
}

.wf-quiz-num {
  font-size: 10px;
  color: #888;
  background: #eee;
  padding: 2px 8px;
  border-radius: 999px;
  display: inline-block;
  margin-bottom: 8px;
}

.wf-quiz-q {
  font-size: 14px;
  font-weight: 600;
  color: #2b2b2b;
  margin-bottom: 10px;
}

.wf-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.wf-option {
  padding: 10px 12px;
  border: 1px solid #dcdcdc;
  border-radius: 8px;
  font-size: 13px;
  color: #555;
  background: #fff;
}

.wf-option-active {
  border-color: #2b2b2b;
  background: #f2f2f2;
  color: #1c1c1c;
  font-weight: 600;
}

/* ---------- 解锁 & 单词卡 ---------- */
.wf-unlock {
  padding: 22px 18px;
  border-bottom: 1px solid #e3e3e3;
}

.wf-word-card {
  border: 2px solid #2b2b2b;
  border-radius: 12px;
  padding: 16px;
  background: #fafafa;
}

.wf-word-card-label {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  background: #5a5a5a;
  padding: 3px 10px;
  border-radius: 999px;
  margin-bottom: 12px;
}

.wf-word-card-body {
  display: flex;
  align-items: center;
  gap: 16px;
}

.wf-word-card-icon {
  width: 60px;
  height: 60px;
  border: 1px dashed #b0b0b0;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  background: #fff;
  flex-shrink: 0;
}

.wf-word-en {
  font-size: 22px;
  font-weight: 800;
  color: #1c1c1c;
  line-height: 1.2;
}

.wf-word-cn {
  font-size: 13px;
  color: #666;
  margin-top: 4px;
}

.wf-unlock-note {
  text-align: center;
  font-size: 12px;
  color: #888;
  margin-top: 14px;
}

/* ---------- 底部 ---------- */
.wf-actions {
  padding: 22px 18px 30px;
}

.wf-btn {
  display: block;
  width: 100%;
  padding: 14px;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  border-radius: 8px;
  cursor: pointer;
  border: none;
  font-family: inherit;
}

.wf-btn-primary {
  background: #2b2b2b;
  color: #ffffff;
}
