.kids-page{--ink:#16324a;--muted:#617989;--sky:#eaf7f7;--line:#c8e1df;--yellow:#ffd45c;--coral:#ff8b70;--blue:#78cbd0;max-width:720px;min-height:100vh;margin:0 auto;padding:0 22px;background:var(--sky);color:var(--ink);font-family:Arial,'PingFang SC','Microsoft YaHei',sans-serif;overflow:hidden}.kids-page *{box-sizing:border-box}.kids-page a{color:inherit;text-decoration:none}.kids-header{height:68px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.kids-brand{display:flex;align-items:center;gap:8px;font-size:17px;font-weight:800;letter-spacing:-.04em}.brand-sprout{display:grid;place-items:center;width:27px;height:27px;border-radius:9px;background:var(--yellow);font-size:16px}.header-link{font-size:12px;font-weight:700}.header-link span,.primary-button span,.join-button span{margin-left:10px}.kids-hero{display:grid;grid-template-columns:1fr .9fr;gap:16px;align-items:center;min-height:420px;padding:48px 0 56px}.eyebrow{margin:0 0 15px;color:#648780;font-size:11px;font-weight:800;letter-spacing:.12em}.kids-page h1,.kids-page h2,.kids-page h3,.kids-page p{margin-top:0}.kids-page h1,.kids-page h2{letter-spacing:-.075em;line-height:1.02}.kids-page h1{font-size:clamp(42px,9vw,68px);margin-bottom:19px}.kids-page h1 span,.kids-page h2 span{color:#ef765d}.hero-text{max-width:245px;color:var(--muted);font-size:14px;line-height:1.6;margin-bottom:25px}.primary-button,.join-button{display:inline-flex;align-items:center;padding:13px 16px;border-radius:14px;font-size:12px;font-weight:800;transition:transform .2s ease,box-shadow .2s ease}.primary-button{background:var(--ink);color:#fff}.kids-page a.primary-button,.kids-page a.join-button{color:#fff}.primary-button:hover,.join-button:hover{transform:translateY(-2px);box-shadow:0 7px 0 rgba(22,50,74,.12)}.planet-art{position:relative;aspect-ratio:1;min-height:260px}.planet{position:absolute;left:13%;top:16%;width:74%;aspect-ratio:1;border-radius:50%;background:var(--blue);box-shadow:inset -15px -18px 0 rgba(42,142,153,.15),8px 14px 0 rgba(22,50,74,.08);display:grid;place-items:center}.planet-face{margin-top:22%;font-size:29px;letter-spacing:8px;color:var(--ink);transform:rotate(-4deg)}.leaf{position:absolute;top:0;width:34px;height:55px;background:#72b991;border-radius:100% 0 100% 0;transform-origin:bottom center}.leaf-left{left:39%;transform:rotate(-24deg)}.leaf-right{left:50%;transform:rotate(29deg) scaleX(-1);background:#8ac9a1}.orbit{position:absolute;border:1.5px solid rgba(22,50,74,.25);border-radius:50%;transform:rotate(-25deg)}.orbit-one{inset:13% 0 19%;}.orbit-two{inset:23% -7% 26%;transform:rotate(45deg)}.star{position:absolute;color:#f1aa43;font-size:23px}.star-one{right:1%;top:7%}.star-two{left:3%;bottom:16%;font-size:30px}.challenge{padding:35px 0 47px;border-top:1px solid var(--line)}.challenge h2{font-size:38px;margin-bottom:28px}.task-list{border-top:1px solid var(--line)}.task{display:grid;grid-template-columns:30px 1fr 20px;gap:12px;align-items:start;padding:17px 0;border-bottom:1px solid var(--line)}.task-number{color:#82a29e;font-size:11px;font-weight:800;padding-top:4px}.task h3{font-size:17px;margin-bottom:5px}.task p{color:var(--muted);font-size:12px;line-height:1.5;margin:0}.task-mark{color:var(--coral);font-size:19px;transform:rotate(45deg)}.join-card{display:flex;align-items:end;justify-content:space-between;gap:24px;padding:28px 25px;background:var(--yellow);border-radius:22px;margin-bottom:36px}.join-card .eyebrow{color:#8d7626}.join-card h2{font-size:34px;margin:0}.join-button{background:var(--coral);color:#fff;white-space:nowrap}.kids-footer{display:flex;justify-content:space-between;gap:10px;padding:18px 0 25px;border-top:1px solid var(--line);color:#6c898e;font-size:11px}.kids-footer span:first-child{font-weight:800;color:var(--ink)}@media(max-width:600px){.kids-page{padding:0 16px}.kids-header{height:58px}.kids-hero{display:flex;flex-direction:column;align-items:stretch;gap:12px;min-height:0;padding:35px 0 38px}.kids-page h1{font-size:48px}.hero-text{margin-bottom:20px}.planet-art{width:78%;align-self:center;min-height:230px}.challenge{padding-top:28px}.challenge h2{font-size:36px}.join-card{display:block;padding:25px 20px}.join-card h2{font-size:32px;margin-bottom:25px}.kids-footer{flex-wrap:wrap}.kids-footer span:last-child{width:100%}}@media(prefers-reduced-motion:reduce){.kids-page *{transition:none!important}}