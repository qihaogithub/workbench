<!DOCTYPE html><html lang="zh-CN"><head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>表彰页-获奖弹窗</title>
  <style>
    /* Reset default margins */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 20px;
      background-color: #f5f5f5;
    }
    
    /* Figma export container */
    .figma-export {
      background: white;
      width: 375px;
      height: 812px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body>
  <div class="figma-export">
<div data-layer="表彰页-获奖弹窗" style="width: 375px; height: 812px; position: relative; background: #4FA576; overflow: hidden">
  <img class="Image122" data-layer="image 122" src="https://img.onlywnn.cn/figma/h_5d84239b.png" style="width: 375px; height: 812px; left: 0px; top: 0px; position: absolute">
  <img alt="static layer" class="Static3" data-figma-id="9196:13743" data-layer="#static 3" data-property-1="1" src="https://img.onlywnn.cn/figma/h_6d9132d8.png" style="left: 75px; top: 256px; position: absolute; width: 224px; height: 286px; object-fit: cover">
  <div data-layer="徽章改动" style="width: 125px; height: 125px; left: 203px; top: 432px; position: absolute; overflow: hidden">
    <img class="Image19" data-layer="image 19" src="https://img.onlywnn.cn/figma/h_21c24e04.png" style="width: 125px; height: 118px; left: 0px; top: 2px; position: absolute">
  </div>
  <img alt="static layer" class="StaticFrame345" data-figma-id="9196:13746" data-layer="#static Frame 345" src="https://img.onlywnn.cn/figma/h_39b6470c.png" style="left: 54px; top: 587px; position: absolute; width: 266px; height: 36px; object-fit: cover">
  <img alt="static layer" class="StaticFrame169" data-figma-id="9196:13749" data-layer="#static Frame 169" src="https://img.onlywnn.cn/figma/h_e5cbbff4.png" style="left: 23px; top: 180px; position: absolute; width: 328px; height: 72px; object-fit: cover">
  <img alt="static layer" class="Static48" data-figma-id="9196:13754" data-layer="#static 48-关闭-圆圈" src="https://img.onlywnn.cn/figma/h_8ffa4746.png" style="left: 169px; top: 664px; position: absolute; width: 36px; height: 36px; object-fit: cover">
</div>
  </div>

</body></html>