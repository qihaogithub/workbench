<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Figma Export</title>
  <style>
    /* Reset default margins */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 20px;
      background-color: #f5f5f5;
    }
    
    /* Figma export container */
    .figma-export {
      background: white;
      width: 860px;
      height: 968px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body>
  <div class="figma-export">
<div data-layer="pad" class="Pad" style="width: 860px; height: 968px; position: relative; background: white; overflow: hidden">
  <div data-layer="主推区" style="width: 860px; height: 413px; left: 0px; top: 0px; position: absolute; overflow: hidden">
    <img data-layer="pad背景图" class="Pad" style="width: 1366px; height: 413px; left: -253px; top: 0px; position: absolute" src="/api/images/img_rJSXpV4TKQbgEQ" />
    <div data-layer="Rectangle" class="Rectangle" style="width: 1133px; height: 413px; left: -137px; top: 0px; position: absolute; opacity: 0; background: #249699"></div>
    <img src="/api/images/img_4i7IR7ISFjYpcg" alt="vector" data-layer="Vector" class="Vector" style="left: -1px; top: 393px; position: absolute; width: 861px; height: 20px; object-fit: contain" data-figma-id="417:20437" />
    <div data-layer="Auto Layout Horizontal" class="AutoLayoutHorizontal" style="width: 860px; height: 250px; left: -1px; top: 118px; position: absolute; justify-content: center; align-items: flex-end; gap: 14px; display: inline-flex">
      <img src="/api/images/img_TCtm90xlw9iVWw" alt="static layer" data-layer="#static 01" class="Static01" style="position: relative; width: 560px; height: 200px; object-fit: cover" data-figma-id="417:20439" />
      <img src="/api/images/img_H4OzBi946o_WTw" alt="static layer" data-layer="#static pad前景图" class="StaticPad" style="position: relative; width: 700px; height: 275px; object-fit: cover" data-figma-id="428:18200" />
      <img src="/api/images/img_rAZh3gi-wU2boQ" alt="static layer" data-layer="#static 03" class="Static03" style="position: relative; width: 560px; height: 200px; object-fit: cover" data-figma-id="417:20442" />
      <div data-layer="分页指示器" data-property-1="1" style="flex-shrink: 0; padding: 9.54px; left: 401px; top: 248px; position: absolute; border-top-left-radius: 14.31px; justify-content: flex-start; align-items: flex-start; gap: 4.77px; display: flex">
        <div data-layer="Rectangle" class="Rectangle" style="width: 16.69px; height: 7.15px; flex-shrink: 0; position: relative; background: white; border-radius: 85.83px; outline: 1.19px rgba(0, 0, 0, 0.10) solid"></div>
        <div data-layer="Ellipse" class="Ellipse" style="width: 7.15px; height: 7.15px; flex-shrink: 0; position: relative; background: rgba(255, 255, 255, 0.50); border-radius: 9999px; outline: 1.19px rgba(0, 0, 0, 0.10) solid"></div>
        <div data-layer="Ellipse" class="Ellipse" style="width: 7.15px; height: 7.15px; flex-shrink: 0; position: relative; background: rgba(255, 255, 255, 0.50); border-radius: 9999px; outline: 1.19px rgba(0, 0, 0, 0.10) solid"></div>
      </div>
    </div>
  </div>
  <img src="/api/images/img_9BvLEo0whSnOrg" alt="static layer" data-layer="#static 头部固定" class="Static" style="left: 0px; top: 0px; position: absolute; width: 860px; height: 112px; object-fit: cover" data-figma-id="417:13655" />
  <div data-layer="信息流" style="width: 860px; left: 0px; top: 413px; position: absolute; flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 16px; display: inline-flex">
    <div data-layer="Auto Layout Vertical" class="AutoLayoutVertical" style="align-self: stretch; flex-shrink: 0; padding-left: 40px; padding-right: 40px; position: relative; justify-content: space-between; align-items: flex-start; display: inline-flex">
      <img src="/api/images/img_XU6VwRiD0Nq23A" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13660" />
      <img src="/api/images/img_zYpKS_Rsnsi_Og" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13661" />
      <img src="/api/images/img_ZBZHDMxqMAm9iA" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13662" />
      <img src="/api/images/img_CqPYGM6q5-LsWg" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13663" />
      <img src="/api/images/img_0oPMgZx2etStBg" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13664" />
      <img src="/api/images/img_aPmkXfse0c6UvQ" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13665" />
      <img src="/api/images/img_eucAt0vQUhrLbg" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13666" />
      <img src="/api/images/img_rk1EPIUs77kJnA" alt="static layer" data-layer="#static 金刚位" class="Static" style="position: relative; width: 100px; height: 108px; object-fit: cover" data-figma-id="417:13667" />
    </div>
    <div data-layer="Frame 3466321" class="Frame3466321" style="align-self: stretch; flex-shrink: 0; padding-left: 40px; position: relative; justify-content: flex-start; align-items: flex-start; gap: 16px; display: inline-flex">
      <img src="/api/images/img_KXzlgjag0IX7FQ" alt="static layer" data-layer="#static 最近在看" class="Static" style="position: relative; width: 402px; height: 140px; object-fit: cover" data-figma-id="417:13669" />
      <img src="/api/images/img_20RhT15u-0-T8A" alt="static layer" data-layer="#static 我的专属" data-property-1="2" class="Static" style="position: relative; width: 402px; height: 140px; object-fit: cover" data-figma-id="417:13672" />
    </div>
    <div data-layer="配图卡片-单卡片" style="align-self: stretch; flex-shrink: 0; position: relative; flex-direction: column; justify-content: flex-start; align-items: flex-start; display: flex">
      <div data-layer="导航/模块标题" style="align-self: stretch; height: 46px; flex-shrink: 0; padding-left: 40px; padding-right: 40px; padding-top: 8px; padding-bottom: 8px; position: relative; justify-content: space-between; align-items: center; display: inline-flex">
        <div data-layer="标题" style="flex-shrink: 0; position: relative; justify-content: flex-start; align-items: center; gap: 8px; display: flex">
          <div data-layer="Auto Layout Horizontal" class="AutoLayoutHorizontal" style="flex-shrink: 0; position: relative; justify-content: flex-start; align-items: center; gap: 4px; display: flex">
            <div data-layer="icon" class="Icon" style="width: 28px; height: 28px; flex-shrink: 0; position: relative; overflow: hidden">
              <img src="/api/images/img_NLjdW4ijhYF8tw" alt="vector" data-layer="􀤟" style="left: 5.76px; top: 4.10px; position: absolute; width: 16px; height: 20px; object-fit: contain" data-figma-id="428:18237" />
            </div>
            <div data-layer="配图卡片-单卡片" style="flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #DBAF00; font-size: 20px; font-family: PingFang SC; font-weight: 500; line-height: 30px; white-space: nowrap">配图卡片-单卡片</div>
          </div>
        </div>
        <div data-layer="按钮" style="height: 26px; flex-shrink: 0; padding-left: 12px; position: relative; background: white; box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.06), 0px 0px 2px rgba(0, 0, 0, 0.06) inset; border-radius: 999px; justify-content: flex-end; align-items: center; display: flex">
          <div data-layer="更多" style="flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #DBAF00; font-size: 14px; font-family: PingFang SC; font-weight: 400; white-space: nowrap">更多</div>
          <div data-layer="Frame" class="Frame" style="width: 20px; height: 20px; flex-shrink: 0; position: relative; transform: rotate(180deg); transform-origin: top left">
            <img src="/api/images/img_uV3m6pOeOg86Ow" alt="vector" data-layer="Vector" class="Vector" style="left: 4.52px; top: 3.64px; position: absolute; width: 10px; height: 8px; object-fit: contain" data-figma-id="428:18236" />
          </div>
        </div>
      </div>
      <div data-layer="Frame 48095927" class="Frame48095927" style="align-self: stretch; flex-shrink: 0; padding-left: 40px; padding-right: 40px; position: relative; overflow: hidden; border-radius: 10px; flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 10px; display: flex">
        <div data-layer="Frame 48095931" class="Frame48095931" style="align-self: stretch; height: 139.70px; flex-shrink: 0; position: relative; overflow: hidden; border-radius: 10px">
          <img data-layer="一行1卡-pad 1" class="1Pad1" style="width: 780px; height: 139.70px; left: 0px; top: 0px; position: absolute" src="/api/images/img_Xa6TJCaH7BMOxg" />
        </div>
      </div>
    </div>
  </div>
  <img src="/api/images/img_sCapoVKDB_eCqw" alt="static layer" data-layer="#static 吸底标签栏" data-设备="pad" data-选中tab="伴读" class="Static" style="left: 0px; top: 906px; position: absolute; width: 860px; height: 62px; object-fit: cover" data-figma-id="417:13680" />
</div>
  </div>
</body>
</html>