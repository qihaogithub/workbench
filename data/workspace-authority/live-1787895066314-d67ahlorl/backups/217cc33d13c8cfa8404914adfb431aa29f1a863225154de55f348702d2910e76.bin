/* OP1 · 王者天梯 */
* { margin: 0; padding: 0; box-sizing: border-box; }

.scene {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  background: linear-gradient(180deg, #0e1a3a 0%, #22335f 26%, #45609a 52%, #7f9cc9 74%, #b8cbe6 92%, #dfe9f5 100%);
  padding-bottom: 84px;
}

/* 天空 */
.sky { position: absolute; inset: 0; pointer-events: none; }

/* 光柱 */
.beams {
  position: absolute;
  top: -20%;
  left: 50%;
  width: 480px;
  height: 90%;
  transform: translateX(-50%);
  background: linear-gradient(180deg, rgba(255,255,255,.5), rgba(255,255,255,0));
  filter: blur(30px);
  opacity: .35;
  animation: beamPulse 6s ease-in-out infinite;
}
@keyframes beamPulse { 0%,100% { opacity: .25; } 50% { opacity: .5; } }

/* 云朵 */
.cloud {
  position: absolute;
  background: rgba(255,255,255,.55);
  border-radius: 999px;
  filter: blur(6px);
  animation: cloudDrift linear infinite;
}
.cloud-1 { width: 120px; height: 40px; top: 18%; left: -10%; animation-duration: 18s; }
.cloud-2 { width: 90px; height: 32px; top: 34%; left: 70%; animation-duration: 14s; animation-delay: 2s; }
.cloud-3 { width: 150px; height: 46px; top: 8%; left: 40%; animation-duration: 22s; animation-delay: 1s; }
.cloud::before, .cloud::after {
  content: "";
  position: absolute;
  background: inherit;
  border-radius: 50%;
}
.cloud::before { width: 55%; height: 180%; top: -80%; left: 18%; }
.cloud::after { width: 40%; height: 130%; top: -50%; right: 16%; }
@keyframes cloudDrift { from { transform: translateX(-40px); } to { transform: translateX(30vw); } }

/* 迷雾 */
.fog {
  position: absolute;
  width: 200%;
  height: 120px;
  left: -50%;
  background: radial-gradient(ellipse at center, rgba(210,220,235,.7), rgba(210,220,235,0) 70%);
  filter: blur(18px);
  animation: fogFloat 8s ease-in-out infinite;
}
.fog-a { bottom: 26%; opacity: .6; }
.fog-b { bottom: 10%; opacity: .45; animation-delay: 3s; }
@keyframes fogFloat { 0%,100% { transform: translateX(0); } 50% { transform: translateX(40px); } }

/* 顶端宝藏旗 */
.summit {
  position: absolute;
  top: 12%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
}
.summit .flag {
  width: 0; height: 0;
  border-left: 34px solid transparent;
  border-right: 34px solid transparent;
  border-bottom: 54px solid rgba(255,235,150,.9);
  border-radius: 4px;
  filter: drop-shadow(0 8px 16px rgba(255,220,120,.6));
  animation: flagFloat 3s ease-in-out infinite;
  position: relative;
}
@keyframes flagFloat { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-10px) rotate(2deg); } }

/* 天梯 */
.ladder {
  position: absolute;
  top: 20%;
  left: 50%;
  width: 220px;
  height: 46%;
  transform: translateX(-50%);
  perspective: 700px;
}
.rail {
  position: absolute;
  top: 0; bottom: 0;
  width: 7px;
  background: linear-gradient(180deg, #f0e0c0, #b89a6a);
  border-radius: 6px;
  box-shadow: 0 0 10px rgba(255,220,160,.4);
}
.rail-left { left: 0; }
.rail-right { right: 0; }
.step {
  position: absolute;
  height: 8px;
  width: 100%;
  left: 0;
  background: linear-gradient(180deg, #e7d3ac, #bfa06c);
  border-radius: 6px;
  box-shadow: 0 4px 8px rgba(0,0,0,.25);
  animation: stepGlow 2.4s ease-in-out infinite;
}
@keyframes stepGlow { 0%,100% { box-shadow: 0 4px 8px rgba(0,0,0,.25); } 50% { box-shadow: 0 4px 16px rgba(255,235,160,.7); } }
.step-1 { bottom: 0; }
.step-2 { bottom: 12%; animation-delay: .2s; }
.step-3 { bottom: 24%; animation-delay: .4s; }
.step-4 { bottom: 36%; animation-delay: .6s; }
.step-5 { bottom: 48%; animation-delay: .8s; }
.step-6 { bottom: 60%; animation-delay: 1s; }

/* 绿豆角色（背身） */
.bean {
  position: absolute;
  bottom: 6%;
  left: 50%;
  transform: translateX(-50%);
  width: 46px;
  height: 58px;
  animation: beanClimb 3s ease-in-out infinite;
}
@keyframes beanClimb {
  0% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-26px); }
  100% { transform: translateX(-50%) translateY(0); }
}
.bean-body {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 40% 32%, #aee37a, #5db13e 72%);
  border-radius: 52% 52% 46% 46%;
  box-shadow: inset -6px -8px 12px rgba(0,0,0,.22);
}
.bean-arm {
  position: absolute;
  top: 34%;
  width: 14px;
  height: 20px;
  background: #6fbf4a;
  border-radius: 8px;
  transform-origin: top center;
}
.arm-left { left: -8px; transform: rotate(-30deg); animation: armSwingL 3s ease-in-out infinite; }
.arm-right { right: -8px; transform: rotate(30deg); animation: armSwingR 3s ease-in-out infinite; }
@keyframes armSwingL { 0%,100% { transform: rotate(-30deg); } 50% { transform: rotate(-70deg); } }
@keyframes armSwingR { 0%,100% { transform: rotate(30deg); } 50% { transform: rotate(70deg); } }

/* 文案 */
.hero {
  position: relative;
  z-index: 3;
  text-align: center;
  padding: 26px 20px 0;
}
.slogan {
  display: inline-block;
  color: #ffe9b0;
  letter-spacing: 6px;
  font-size: 13px;
  font-weight: 700;
  padding: 4px 16px;
  border: 1px solid rgba(255,233,176,.5);
  border-radius: 999px;
  background: rgba(255,233,176,.08);
  margin-bottom: 12px;
}
.title {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
  line-height: 1.4;
  text-shadow: 0 3px 10px rgba(0,0,0,.35);
  letter-spacing: 1px;
}
.subtitle {
  color: #cfe0ff;
  font-size: 14px;
  margin-top: 10px;
  letter-spacing: 1px;
  text-shadow: 0 2px 6px rgba(0,0,0,.3);
}

/* 按钮 */
.actions {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 22px 24px;
  max-width: 420px;
  margin: 0 auto;
}
.btn {
  width: 100%;
  padding: 15px 10px;
  border: none;
  border-radius: 999px;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 2px;
  cursor: pointer;
  font-family: inherit;
}
.btn-primary {
  background: linear-gradient(180deg, #ffd76b, #ff9f2e);
  color: #6a3c00;
  box-shadow: 0 8px 20px rgba(255,159,46,.45), inset 0 2px 0 rgba(255,255,255,.5);
  animation: btnBreathe 2.4s ease-in-out infinite;
}
.btn-primary:hover { transform: translateY(-1px); filter: brightness(1.04); }
@keyframes btnBreathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.02); } }
.hint {
  text-align: center;
  color: #9db6e6;
  font-size: 12px;
  margin: -4px 0 2px;
  letter-spacing: 1px;
}
.btn-ghost {
  background: rgba(255,255,255,.14);
  color: #e8f1ff;
  border: 1px solid rgba(255,255,255,.4);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.15);
}
.btn-ghost:hover { background: rgba(255,255,255,.22); }
.btn-disabled {
  background: rgba(255,255,255,.08);
  color: #7b8db4;
  cursor: not-allowed;
  border: 1px solid rgba(255,255,255,.12);
}