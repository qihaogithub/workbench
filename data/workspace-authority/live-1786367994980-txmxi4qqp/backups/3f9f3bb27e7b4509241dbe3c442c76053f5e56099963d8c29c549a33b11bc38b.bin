/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: #f5f5f5;
  color: #333;
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* Page container - mobile frame */
.page {
  max-width: 375px;
  margin: 0 auto;
  background: #fff;
  min-height: 100vh;
}

/* ========== Header ========== */
.header {
  text-align: center;
  padding: 32px 24px 24px;
  border-bottom: 1px dashed #ccc;
}

.logo-placeholder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border: 2px solid #333;
  border-radius: 50%;
  margin-bottom: 12px;
  color: #333;
}

.logo-icon {
  color: #333;
}

.brand-title {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 4px;
}

.brand-subtitle {
  font-size: 13px;
  color: #888;
}

/* ========== Hero ========== */
.hero {
  padding: 24px;
  text-align: center;
  border-bottom: 1px dashed #ccc;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  background: #fafafa;
  border: 1px solid #ccc;
  border-radius: 4px;
  color: #aaa;
  font-size: 12px;
  margin-bottom: 16px;
  overflow: hidden;
}

.image-placeholder-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 100%;
  height: 160px;
  border-bottom: 1px dashed #ddd;
}

.image-placeholder-inner svg {
  opacity: 0.5;
}

.placeholder-label {
  font-size: 13px;
  color: #888;
}

.placeholder-dims {
  font-size: 11px;
  color: #bbb;
}

.design-requirements {
  text-align: left;
  padding: 12px 16px;
  background: #fffbe6;
  border-top: 1px dashed #f0d060;
}

.design-requirements h4 {
  font-size: 13px;
  font-weight: 600;
  color: #666;
  margin-bottom: 8px;
}

.design-requirements ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.design-requirements li {
  font-size: 11px;
  color: #888;
  line-height: 1.6;
  padding: 2px 0;
  border-bottom: 1px dotted #f0e6c0;
}

.design-requirements li:last-child {
  border-bottom: none;
}

.design-requirements strong {
  color: #666;
  font-weight: 600;
}

.hero-title {
  font-size: 20px;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 8px;
}

.hero-desc {
  font-size: 13px;
  color: #888;
  margin-bottom: 12px;
}

.tag-group {
  display: flex;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

.tag {
  display: inline-block;
  padding: 4px 12px;
  border: 1px solid #ccc;
  border-radius: 12px;
  font-size: 12px;
  color: #666;
  background: #fafafa;
}

/* ========== Section Titles ========== */
.section-title {
  font-size: 16px;
  font-weight: 700;
  padding: 20px 24px 12px;
  border-bottom: 1px solid #eee;
}

/* ========== Info Cards ========== */
.info-section {
  border-bottom: 1px dashed #ccc;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  padding: 0;
}

.card {
  text-align: center;
  padding: 20px 8px;
  border-right: 1px solid #eee;
}

.card:last-child {
  border-right: none;
}

.card-icon {
  font-size: 28px;
  margin-bottom: 8px;
  /* wireframe style: replace emoji with outlined box */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border: 1px dashed #ccc;
  border-radius: 8px;
  background: #fafafa;
}

.card h4 {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
}

.card p {
  font-size: 11px;
  color: #999;
  line-height: 1.4;
}

/* ========== Timeline ========== */
.schedule-section {
  border-bottom: 1px dashed #ccc;
}

.timeline {
  padding: 16px 24px 24px;
}

.timeline-item {
  display: flex;
  gap: 16px;
  padding-bottom: 20px;
  position: relative;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  flex-shrink: 0;
  width: 12px;
  height: 12px;
  border: 2px solid #333;
  border-radius: 50%;
  background: #fff;
  margin-top: 4px;
  position: relative;
}

/* vertical line between dots */
.timeline-item:not(:last-child) .timeline-dot::after {
  content: '';
  position: absolute;
  left: 5px;
  top: 12px;
  width: 2px;
  height: calc(100% + 8px);
  background: #ddd;
  border-style: dashed;
}

.timeline-content {
  flex: 1;
  padding-bottom: 4px;
  border-bottom: 1px solid #f0f0f0;
}

.timeline-item:last-child .timeline-content {
  border-bottom: none;
}

.timeline-date {
  font-size: 11px;
  color: #aaa;
  display: block;
  margin-bottom: 2px;
}

.timeline-content h4 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 4px;
}

.timeline-content p {
  font-size: 12px;
  color: #999;
  line-height: 1.5;
}

/* ========== Stats ========== */
.stats-section {
  border-bottom: 1px dashed #ccc;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 20px 24px;
  gap: 0;
}

.stat {
  text-align: center;
  padding: 12px 4px;
  border-right: 1px solid #eee;
}

.stat:last-child {
  border-right: none;
}

.stat-number {
  display: block;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 4px;
}

.stat-label {
  display: block;
  font-size: 11px;
  color: #999;
}

/* ========== Testimonials ========== */
.testimonial-section {
  border-bottom: 1px dashed #ccc;
}

.testimonial-list {
  padding: 16px 24px 24px;
}

.testimonial-card {
  padding: 16px;
  border: 1px solid #eee;
  border-radius: 4px;
  margin-bottom: 12px;
  background: #fafafa;
}

.testimonial-card:last-child {
  margin-bottom: 0;
}

.avatar-placeholder {
  width: 32px;
  height: 32px;
  border: 1px solid #ccc;
  border-radius: 50%;
  background: #f0f0f0;
  margin-bottom: 8px;
}

.testimonial-card p {
  font-size: 13px;
  color: #555;
  line-height: 1.5;
  margin-bottom: 8px;
  font-style: italic;
}

.testimonial-card .author {
  font-size: 11px;
  color: #aaa;
  font-style: normal;
}

/* ========== Price ========== */
.price-section {
  border-bottom: 1px dashed #ccc;
}

.price-card {
  margin: 16px 24px;
  padding: 20px;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fafafa;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #eee;
  font-size: 13px;
}

.price-row:last-of-type {
  border-bottom: none;
}

.price-row.highlight {
  font-weight: 600;
}

.price {
  font-size: 16px;
  font-weight: 700;
}

.price s {
  font-size: 12px;
  color: #bbb;
  font-weight: 400;
  margin-left: 4px;
  text-decoration: line-through;
}

.price-note {
  font-size: 11px;
  color: #aaa;
  margin-top: 10px;
  text-align: center;
}

/* ========== CTA ========== */
.cta-section {
  padding: 24px;
  text-align: center;
}

.cta-desc {
  font-size: 13px;
  color: #888;
  margin-top: 4px;
  margin-bottom: 20px;
}

.cta-button {
  display: inline-block;
  width: 200px;
  padding: 14px 0;
  border: 2px solid #333;
  border-radius: 24px;
  background: #333;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 2px;
  transition: opacity 0.2s;
}

.cta-button:active {
  opacity: 0.8;
}

.cta-hint {
  font-size: 11px;
  color: #bbb;
  margin-top: 12px;
}

/* ========== Footer ========== */
.footer {
  text-align: center;
  padding: 24px;
}

.footer-divider {
  height: 1px;
  background: #eee;
  margin-bottom: 20px;
}

.footer-text {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
}

.footer-contact {
  font-size: 12px;
  color: #999;
  margin-bottom: 12px;
}

.footer-copy {
  font-size: 10px;
  color: #ccc;
}
