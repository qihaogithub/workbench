interface DemoProps {
  /** 广告图 - 平板广告图，1行1个 */
  field?: string;
}

const DEFAULT_AD_IMAGE = '/api/images/img_iCbilU1Lf0lJCQ';

export default function PadBanduAd({ field }: DemoProps) {
  const padAssetBase = 'https://uiweb.oss-cn-chengdu.aliyuncs.com/img/伴读/轮播广告/pad';
  const sharedPhoneAssetBase = 'https://uiweb.oss-cn-chengdu.aliyuncs.com/img/伴读/轮播广告/手机';

  const adImageSrc = (field || '').trim() ? field : DEFAULT_AD_IMAGE;
  const carouselAdImage = `${sharedPhoneAssetBase}/广告图.png`;

  const sideImages = ['配图-3.png', '配图-4.png', '配图-5.png', '配图-6.png'];

  return (
    <div
      className="relative mx-auto overflow-hidden bg-white"
      style={{ width: 1133, maxWidth: '100%', height: '100vh', minHeight: 749, backgroundColor: '#ffffff' }}
    >
      <img
        src={`${padAssetBase}/底部吸顶内容.png`}
        alt="顶部吸顶内容"
        className="absolute left-px top-0 z-20 h-[90px] w-[1132px]"
        style={{ position: 'absolute', left: 1, top: 0, zIndex: 20, width: 1132, height: 90, display: 'block' }}
      />

      <div
        className="absolute left-0 top-[90px] flex h-[592px] w-[1133px] flex-col items-center bg-white"
        style={{
          position: 'absolute',
          left: 0,
          top: 90,
          width: 1133,
          height: 592,
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          backgroundColor: '#ffffff',
        }}
      >
        <img
          src={`${padAssetBase}/1.png`}
          alt="顶部区域"
          className="h-[188px] w-[1133px] shrink-0 object-cover"
          style={{ width: 1133, height: 188, objectFit: 'cover', flexShrink: 0, display: 'block' }}
        />

        <div
          className="shrink-0 overflow-hidden rounded-[12px] bg-white"
          style={{
            width: 1005,
            height: 180,
            overflow: 'hidden',
            borderRadius: 12,
            backgroundColor: '#ffffff',
            flexShrink: 0,
          }}
        >
          <img
            src={adImageSrc}
            alt="平板广告图"
            className="h-[180px] w-[1005px] object-cover"
            style={{ width: 1005, height: 180, objectFit: 'cover', display: 'block' }}
          />
        </div>

        <div
          className="flex w-[1133px] shrink-0 flex-col items-start"
          style={{ width: 1133, display: 'flex', flexDirection: 'column', alignItems: 'flex-start', flexShrink: 0 }}
        >
          <img
            src={`${padAssetBase}/配图-1.png`}
            alt="活动标题"
            className="h-[61px] w-[1133px]"
            style={{ width: 1133, height: 61, display: 'block' }}
          />

          <div
            className="flex h-[100px] w-full items-center gap-[10px] px-[64px]"
            style={{
              display: 'flex',
              height: 100,
              width: '100%',
              alignItems: 'center',
              gap: 10,
              paddingLeft: 64,
              paddingRight: 64,
            }}
          >
            <img
              src={carouselAdImage}
              alt="轮播广告图"
              className="h-full w-[210px] rounded-[9px] bg-[#d9d9d9] object-cover"
              style={{
                height: '100%',
                width: 210,
                borderRadius: 9,
                backgroundColor: '#d9d9d9',
                objectFit: 'cover',
                flexShrink: 0,
              }}
            />

            {sideImages.map((imageName) => (
              <img
                key={imageName}
                src={`${padAssetBase}/${imageName}`}
                alt=""
                className="h-[100px] rounded-[9px]"
                style={{ height: 100, borderRadius: 9, flexShrink: 0, display: 'block' }}
              />
            ))}
          </div>
        </div>
      </div>

      <img
        src={`${padAssetBase}/吸底标签栏.png`}
