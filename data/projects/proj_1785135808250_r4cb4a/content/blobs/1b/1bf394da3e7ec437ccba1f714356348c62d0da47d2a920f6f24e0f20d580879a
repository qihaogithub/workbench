interface LevelItem {
  label: string;
  status: 'locked' | 'unlocked' | 'completed';
  posX: number;
  posY: number;
}

interface DemoProps {
  levelBgImage?: string;
  levelLockedImage?: string;
  levelUnlockedImage?: string;
  levelCompletedImage?: string;
  showPathLines?: boolean;
  pathLineColor?: string;
  levels?: LevelItem[];
}

export default function Demo({
  levelBgImage = '',
  levelLockedImage = '',
  levelUnlockedImage = '',
  levelCompletedImage = '',
  showPathLines = true,
  pathLineColor = '#FFD700',
  levels = [],
}: DemoProps) {
  const getLevelImage = (status: string) => {
    switch (status) {
      case 'completed':
        return levelCompletedImage;
      case 'unlocked':
        return levelUnlockedImage;
      default:
        return levelLockedImage;
    }
  };

  const getStatusIcon = (status: string) => {
    switch (status) {
      case 'completed':
        return (
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="10" fill="#22C55E" />
            <path d="M6 10L9 13L14 7" stroke="white" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
          </svg>
        );
      case 'unlocked':
        return (
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="10" fill="#3B82F6" />
            <path d="M7 9V7C7 5.343 8.343 4 10 4C11.657 4 13 5.343 13 7" stroke="white" strokeWidth="1.5" strokeLinecap="round" />
            <rect x="6" y="9" width="8" height="6" rx="1.5" fill="white" />
            <circle cx="10" cy="12" r="1" fill="#3B82F6" />
          </svg>
        );
      default:
        return (
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="10" fill="#9CA3AF" />
            <path d="M7 9V7C7 5.343 8.343 4 10 4C11.657 4 13 5.343 13 7" stroke="white" strokeWidth="1.5" strokeLinecap="round" />
            <rect x="6" y="9" width="8" height="6" rx="1.5" fill="white" />
          </svg>
        );
    }
  };

  if (!levels || levels.length === 0) {
    return (
      <div className="w-full min-h-[400px] flex items-center justify-center bg-gray-100 rounded-2xl">
        <p className="text-gray-400 text-sm">请在右侧配置面板中添加关卡</p>
      </div>
    );
  }

  return (
    <div className="relative w-full min-h-[500px] overflow-hidden rounded-2xl bg-gray-50">
      {/* 关卡背景图 */}
      {levelBgImage && (
        <img
          src={levelBgImage}
          alt="关卡背景"
          className="absolute inset-0 w-full h-full object-cover"
        />
      )}

      {/* 关卡间连线 */}
      {showPathLines && levels.length > 1 && (
        <svg className="absolute inset-0 w-full h-full pointer-events-none" style={{ zIndex: 1 }}>
          {levels.slice(0, -1).map((level, index) => {
            const next = levels[index + 1];
            const isLocked = next.status === 'locked';
            return (
              <g key={`line-${index}`}>
                {/* 发光效果 */}
                <line
                  x1={`${level.posX}%`}
                  y1={`${level.posY}%`}
                  x2={`${next.posX}%`}
                  y2={`${next.posY}%`}
                  stroke={pathLineColor}
                  strokeWidth="6"
                  strokeLinecap="round"
                  opacity="0.15"
                />
                {/* 主线条 */}
                <line
                  x1={`${level.posX}%`}
                  y1={`${level.posY}%`}
                  x2={`${next.posX}%`}
                  y2={`${next.posY}%`}
                  stroke={pathLineColor}
                  strokeWidth="3"
                  strokeLinecap="round"
                  strokeDasharray={isLocked ? '6,4' : 'none'}
                  opacity={isLocked ? 0.4 : 0.85}
                />
              </g>
            );
          })}
        </svg>
      )}

      {/* 关卡节点 */}
      {levels.map((level, index) => {
        const statusColors: Record<string, string> = {
          completed: 'bg-green-500 ring-green-300',
          unlocked: 'bg-blue-500 ring-blue-300',
          locked: 'bg-gray-400 ring-gray-300',
        };

        return (
          <div
            key={index}
            className="absolute transform -translate-x-1/2 -translate-y-1/2 flex flex-col items-center transition-all duration-300 hover:scale-110"
            style={{ left: `${level.posX}%`, top: `${level.posY}%`, zIndex: 10 }}
          >
            {/* 关卡图标 */}
            <div className="relative w-14 h-14">
              {getLevelImage(level.status) ? (
                <div className="relative w-full h-full">
                  <img
                    src={getLevelImage(level.status)}
                    alt={level.label}
                    className="w-full h-full object-contain drop-shadow-lg"
                  />
                  {/* 状态徽章 */}
                  <div className="absolute -top-1.5 -right-1.5">
                    {getStatusIcon(level.status)}
                  </div>
                </div>
              ) : (
                <div className={`w-full h-full rounded-2xl ${statusColors[level.status]} ring-4 flex items-center justify-center shadow-lg`}>
                  <span className="text-white text-lg font-bold">{index + 1}</span>
                  <div className="absolute -top-1.5 -right-1.5">
                    {getStatusIcon(level.status)}
                  </div>
                </div>
              )}
            </div>

            {/* 关卡名称标签 */}
            <div className="mt-1.5 px-3 py-1 bg-black/60 backdrop-blur-sm rounded-full text-white text-xs font-medium whitespace-nowrap shadow">
              {level.label}
            </div>
          </div>
        );
      })}
    </div>
  );
}