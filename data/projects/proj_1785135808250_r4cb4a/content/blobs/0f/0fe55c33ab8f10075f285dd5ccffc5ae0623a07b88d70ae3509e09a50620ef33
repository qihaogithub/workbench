{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$demo": {
    "presentation": {
      "version": 1,
      "mode": "fixed-canvas",
      "viewport": {
        "width": 375,
        "height": 812
      },
      "heightBehavior": "fixed",
      "preset": "custom",
      "source": "figma"
    }
  },
  "properties": {
    "spineAsset": {
      "type": "object",
      "format": "spine",
      "title": "Spine 素材",
      "description": "上传包含骨架、图集和全部纹理的 Spine ZIP 素材包。",
      "properties": {
        "kind": { "const": "spine" },
        "version": { "const": 1 },
        "assetId": {
          "type": "string",
          "pattern": "^spine_[a-f0-9]{64}$"
        }
      },
      "required": ["kind", "version", "assetId"],
      "additionalProperties": false,
      "ui:options": {
        "accept": ".zip",
        "group": "Spine 动画"
      }
    },
    "spineAnimation": {
      "type": "string",
      "title": "动画名",
      "description": "要播放的动画名，留空则播放第一条",
      "default": "",
      "ui:options": { "group": "Spine 动画" }
    },
    "spineLoop": {
      "type": "boolean",
      "title": "循环播放",
      "default": true,
      "ui:options": { "group": "Spine 动画" }
    }
  },
  "required": []
}
