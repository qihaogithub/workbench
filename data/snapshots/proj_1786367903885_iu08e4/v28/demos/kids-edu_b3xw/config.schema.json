{
  "$demo": {
    "presentation": {
      "version": 1,
      "mode": "responsive-page",
      "viewport": {
        "width": 375,
        "height": 812
      },
      "heightBehavior": "content",
      "preset": "custom",
      "source": "user"
    }
  },
  "type": "object",
  "properties": {
    "heroImage": {
      "title": "主视觉图片",
      "default": "data:image/png;base64,",
      "type": "string",
      "format": "image",
      "ui:options": {
        "maxSize": 1048576,
        "widthRule": {
          "operator": "=",
          "value": 100
        },
        "heightRule": {
          "operator": "=",
          "value": 100
        }
      }
    }
  },
  "required": [
    "heroImage"
  ]
}
