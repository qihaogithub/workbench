{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "活动标题",
      "default": "夏日清凉大促",
      "ui:options": {
        "group": "基础信息"
      }
    },
    "price": {
      "type": "number",
      "title": "优惠价格",
      "default": 29.9,
      "ui:options": {
        "group": "基础信息"
      }
    },
    "stock": {
      "type": "integer",
      "title": "库存数量",
      "default": 99,
      "ui:options": {
        "group": "基础信息"
      }
    },
    "enabled": {
      "type": "boolean",
      "title": "是否开启",
      "default": true,
      "ui:options": {
        "group": "基础信息"
      }
    },
    "desc": {
      "type": "string",
      "maxLength": 1000,
      "title": "活动描述",
      "default": "炎炎夏日，全场冰饮 5 折起，会员再享满减。清凉一夏，好礼不断，快来参与吧！",
      "ui:options": {
        "group": "详细描述"
      }
    }
  },
  "required": [],
  "$demo": {
    "presentation": {
      "version": 1,
      "mode": "responsive-page",
      "viewport": {
        "width": 375,
        "height": 812
      },
      "heightBehavior": "content",
      "preset": "custom",
      "source": "user"
    }
  }
}
